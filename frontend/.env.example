# VITE_API_BASE_URL is only needed if you are NOT using the Vite dev proxy.
# When running `npm run dev`, the proxy in vite.config.js forwards /api/* to
# the backend automatically — you do not need this variable in development.
#
# For production builds, set this to your backend's public URL, e.g.:
#   VITE_API_BASE_URL=https://api.yourdomain.com
#
# Leave blank to use relative paths (suitable when the frontend is served
# by the same host as the backend, or when a reverse proxy is in front).
VITE_API_BASE_URL=

# Refresh interval for live metrics, in milliseconds.
# Default: 30000 (30 seconds). Set to 0 to disable automatic refresh.
VITE_REFRESH_INTERVAL=30000
